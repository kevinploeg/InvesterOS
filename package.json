{
  "name": "investoros",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:bootstrap": "pnpm --filter @investoros/db bootstrap",
    "db:migrate": "pnpm --filter @investoros/db migrate",
    "db:seed": "pnpm --filter @investoros/testing seed",
    "db:lint": "pnpm --filter @investoros/db schema-lint",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p .",
    "lint": "eslint . && depcruise --config .dependency-cruiser.cjs apps packages tooling",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "tsx e2e/prepare.mts && playwright test",
    "build": "pnpm --filter @investoros/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@investoros/db": "workspace:*",
    "@investoros/testing": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
